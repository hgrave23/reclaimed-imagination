---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Suppress indexing, schema, and analytics — use on error/utility pages. */
  noindex?: boolean;
}

const {
  title = "Reclaimed Imagination | Marketing Strategy, Tucson AZ",
  description = "Marketing consulting from sunny Tucson, Arizona. Strategy, story, and purpose-driven marketing with Josh Cohen.",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/images/og-image.jpg", Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Reclaimed Imagination",
  founder: {
    "@type": "Person",
    name: "Josh Cohen",
  },
  description,
  email: "josh@reclaimedimagination.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Tucson",
    addressRegion: "AZ",
    addressCountry: "US",
  },
  url: canonicalURL.toString(),
  sameAs: ["https://www.linkedin.com/in/jacohen614"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#24251b" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Reclaimed Imagination" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}

    {
      !noindex && (
        <Fragment>
          {/* Google tag (gtag.js) */}
          <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-5YYHMZH4MC" />
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-5YYHMZH4MC");
          </script>

          {/* Cloudflare Web Analytics */}
          <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon='{"token": "8e5edf899bc441adaf79e5aff1b1121e"}'
          />
        </Fragment>
      )
    }
  </head>
  <body>
    <slot />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll("[data-reveal], [data-reveal-line]").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
